# Copy to llm/.env and fill in what you use. llm/.env is git-ignored.
# Each variable can also be set in the process environment, which takes precedence.

# OpenAI-compatible endpoint: the scorer's LLM judge, and the default backend of
# llm_evaluate_cascade.py, docetl/langchain/langextract_evaluate.py and llm/gpt.py.
GPT_URL_PRO=
GPT_KEY_PRO=

# Endpoint for deepseek-v* models in llm_evaluate_cascade.py; falls back to GPT_URL_PRO / GPT_KEY_PRO.
GPT_URL_DS=
GPT_KEY_DS=

# Endpoint for llm/dashscope.py (qwen*, glm* models in the cascade) and llm/gpt_vllm.py.
# llm/claude.py also uses GPT_KEY when CLAUDE_API_KEY is not set.
GPT_URL=
GPT_KEY=

# llm/claude.py.
CLAUDE_API_KEY=
ANTHROPIC_URL=
